# ==========================================
# HFF DATA STUDIO - ENVIRONMENT VARIABLES
# ==========================================

# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
DB_URL=jdbc:postgresql://localhost:5432/hff_data_studio_db
DB_USERNAME=postgres
DB_PASSWORD=Pa$$Na$$aIW0rd
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT (OBLIGATOIRE - 256 bits minimum)
JWT_SECRET=change-me-with-a-very-long-random-256-bit-secret-key
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Encryption (32 caractères minimum)
ENCRYPTION_KEY=change-me-32-characters-minimum!!

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=200

# Mail
MAIL_HOST=smtp.hff.re
MAIL_PORT=587
MAIL_USERNAME=noreply@hff.re
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@hff.re
EMAIL_ENABLED=true

# AI
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Python Service
PYTHON_SERVICE_URL=http://localhost:5000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=10

# Admin (initialisation)
DATA_INIT_ENABLED=false
ADMIN_EMAIL=admin@hff.re
ADMIN_PASSWORD=

# Multi-tenancy
TENANT_ENABLED=false

# Observability
SWAGGER_ENABLED=true
HEALTH_SHOW_DETAILS=when-authorized
TRACING_SAMPLE=0.1
LOG_FILE=./logs/hff-data-studio.log